# Copy to .env and fill in to enable real alert delivery.
# Both integrations no-op safely (with a log line) when left blank.

# Slack incoming webhook URL: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# SendGrid API key + a verified sender/recipient
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
